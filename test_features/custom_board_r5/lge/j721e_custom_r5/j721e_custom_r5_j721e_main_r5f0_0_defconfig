# CONFIG_ARM and CONFIG_CPU_CORTEX_R5 come from the SOC_J721E_MAIN_R5F0_0 select chain

# Run out of TCM, not execute-in-place from flash
CONFIG_XIP=n

# Boot components & I/O
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# Standard runtime layers
CONFIG_SHELL=y
CONFIG_LOG=y

# External reference clock frequency for the R5F cluster
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=19200000