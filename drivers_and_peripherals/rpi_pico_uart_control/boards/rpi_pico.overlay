/ {
    chosen {
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
    };

    aliases {
        onboard-led = &led0;
        gnss-uart = &uart1;
    };
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
};

&uart1 {
    status = "okay";
    current-speed = <9600>;

    pinctrl-0 = <&uart1_default>;
    pinctrl-names = "default";

    gnss_ublox_m8: ublox_m8 {
        compatible = "ublox,m8";
        status = "okay";
    };
};

&pinctrl {
    uart1_default: uart_default {
        group1 {
            pinmux = <UART1_TX_P4>;
        };
        group2 {
            pinmux = <UART1_RX_P5>;
            input-enable;
        };
    };
};
